# Copy to .env.local and fill in with values from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# Only the anon / publishable key belongs here. NEVER put the service_role
# key in this file or anywhere in the frontend — it bypasses Row Level Security.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY

# hCaptcha SITE key only (public — it appears in the rendered widget).
# The hCaptcha SECRET key goes in the Supabase dashboard, never here.
# Leave unset to disable the captcha locally (requires captcha also disabled in
# Supabase, or use hCaptcha's test key 10000000-ffff-ffff-ffff-000000000001).
VITE_HCAPTCHA_SITE_KEY=YOUR_HCAPTCHA_SITE_KEY
